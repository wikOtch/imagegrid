{% extends '@nucleus/partials/particle.html.twig' %}

{% do gantry.load('lightcase.init') %}

{% block particle %}

    {% set filter = particle.filter is not defined or particle.filter %}
    {% set search = particle.search %}

    {# Collect the unique tags of all images #}
    {% set alltags = [] %}
    {% for imagegriditem in particle.imagegriditems %}
        {% for tag in imagegriditem.tags|default('')|split(',') %}
            {% set tag = tag|trim|lower %}
            {% if tag and tag not in alltags %}
                {% set alltags = alltags|merge([tag]) %}
            {% endif %}
        {% endfor %}
    {% endfor %}

    {% if particle.title %}<h2 class="g-title">{{ particle.title|raw }}</h2>{% endif %}

    <div class="g-imagegrid {{ particle.class|e }}"{% if (filter or search) and alltags %} data-imagegrid-filter{% endif %}>

        {% if particle.desc %}<div class="g-imagegrid-desc">{{ particle.desc|raw }}</div>{% endif %}

        {% if (filter or search) and alltags %}
            <div class="g-imagegrid-filters">
                {% if search %}
                    {% set searchplaceholder = particle.searchplaceholder|default('Rechercher un tag…') %}
                    <input type="search" class="g-imagegrid-search" placeholder="{{ searchplaceholder|e }}" aria-label="{{ searchplaceholder|e }}" />
                {% endif %}
                {% if filter %}
                    <div class="g-imagegrid-tags" role="group" aria-label="Tags">
                        <button type="button" class="g-imagegrid-filter active" data-filter="*" aria-pressed="true">{{ particle.filterall|default('Tous')|e }}</button>
                        {% for tag in alltags|sort %}
                            <button type="button" class="g-imagegrid-filter" data-filter="{{ tag|e('html_attr') }}" aria-pressed="false">{{ tag|e }}</button>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        <div class="g-imagegrid-wrapper {{ particle.cols|e }} {{ particle.layout }}">
            {% for imagegriditem in particle.imagegriditems %}
                {% set itemtags = [] %}
                {% for tag in imagegriditem.tags|default('')|split(',') %}
                    {% set tag = tag|trim|lower %}
                    {% if tag %}
                        {% set itemtags = itemtags|merge([tag]) %}
                    {% endif %}
                {% endfor %}
                {# Lightcase injects the title and caption as HTML: keep plain text only #}
                {% set alt = imagegriditem.alt|default(imagegriditem.caption)|striptags|trim %}
                {# Film details, copied as text nodes next to the enlarged image by the script below #}
                {% set filmtitle = imagegriditem.filmtitle|default('')|trim %}
                {% set filmdetails = [
                    {label: particle.filmyearlabel|default('Année'), value: imagegriditem.filmyear|default('')|trim},
                    {label: particle.filmdirectorlabel|default('Réalisateur'), value: imagegriditem.filmdirector|default('')|trim},
                    {label: particle.filmproductionlabel|default('Production'), value: imagegriditem.filmproduction|default('')|trim},
                    {label: particle.filmfestivallabel|default('Festival'), value: imagegriditem.filmfestival|default('')|trim}
                ] %}
                {% set hasfilm = filmtitle %}
                {% for detail in filmdetails %}
                    {% if detail.value %}{% set hasfilm = true %}{% endif %}
                {% endfor %}
                <div class="g-imagegrid-item"{% if itemtags %} data-tags="{{ itemtags|join('|')|e('html_attr') }}"{% endif %}>
                    <a class="g-imagegrid-link" href="{{ url(imagegriditem.image)|e }}" data-rel="lightcase{% if particle.album %}:{{ particle.album|e('html_attr') }}{% endif %}"{% if alt %} data-lc-title="{{ alt|e('html_attr') }}"{% endif %}>
                        {% if particle.layout == 'g-imagegrid-captions' %}
                        {% endif %}
                        <img src="{{ url(imagegriditem.image)|e }}" alt="{{ alt|e('html_attr') }}" />
                        <div class="indicator">
                            <div>
                                {% if particle.layout == 'g-imagegrid-standard' %}
                                    {{ imagegriditem.caption }}
                                {% else %}
                                    <div class="g-imagegrid-caption">
                                        {{ imagegriditem.caption }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </a>
                    {% if hasfilm %}
                        <div class="g-imagegrid-film" hidden>
                            {# The lightbox title already shows the alternative text: no need to repeat it #}
                            {% if filmtitle and filmtitle|lower != alt|lower %}
                                <p class="g-imagegrid-film-title">{{ filmtitle|e }}</p>
                            {% endif %}
                            <dl class="g-imagegrid-film-details">
                                {% for detail in filmdetails %}
                                    {% if detail.value %}
                                        <div>
                                            <dt>{{ detail.label|e }}</dt>
                                            <dd>{{ detail.value|e|nl2br }}</dd>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </dl>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}

        </div>

        {% if (filter or search) and alltags %}
            <p class="g-imagegrid-empty" hidden>{{ particle.emptytext|default('Aucune image ne correspond à ce tag.')|e }}</p>
        {% endif %}
    </div>

    {#
        The scripts are written inline, not in a Gantry "scripts" block: when Joomla caching is on,
        the cached page or article keeps the particle HTML but loses the assets Gantry adds to the footer.
    #}
    <script>
        (function () {
            if (window.gImagegridLightcase) { return; }
            window.gImagegridLightcase = true;

            var root = document.documentElement;
            var openClass = 'g-imagegrid-film-open';
            var wide = window.matchMedia ? window.matchMedia('(min-width: 641px)') : null;

            function infoBox() {
                return document.getElementById('lightcase-info');
            }

            function removeFilm() {
                var info = infoBox();
                var box = document.getElementById('lightcase-case');
                var old = info && info.querySelector('.g-imagegrid-film');

                root.classList.remove(openClass);
                if (old) { old.parentNode.removeChild(old); }
                if (info) { info.style.maxHeight = ''; }
                if (box) { box.style.translate = ''; }
            }

            // Height of the lightbox texts, measured even while Lightcase keeps them hidden for the fade-in
            function infoHeight(info) {
                var display = info.style.display;
                var height;

                info.style.display = 'block';
                info.style.maxHeight = '';
                height = info.offsetHeight;
                info.style.display = display;
                return height;
            }

            // Before Lightcase sizes the image: keep room for the film details,
            // next to the image on wide screens, under it on small screens
            function fit() {
                var info = infoBox();
                var settings = window.lightcase && window.lightcase.settings;

                if (!settings || !info || !root.classList.contains(openClass)) { return; }

                if (!wide || wide.matches) {
                    settings.maxWidth = Math.max(160, window.innerWidth - Math.min(344, window.innerWidth * 0.35) - 120);
                    settings.maxHeight = '100%';
                } else {
                    settings.maxWidth = '100%';
                    settings.maxHeight = Math.max(window.innerHeight * 0.4, window.innerHeight - 80 - infoHeight(info));
                }
            }

            // After Lightcase sized the image: keep the image and the details inside the screen
            function place() {
                var info = infoBox();
                var box = document.getElementById('lightcase-case');
                var screen = window.innerHeight;
                var image, details, top;

                if (!info || !box || !root.classList.contains(openClass)) { return; }

                image = box.offsetHeight;
                if (!wide || wide.matches) {
                    box.style.translate = '';
                    info.style.maxHeight = Math.max(120, (screen + image) / 2 - 20) + 'px';
                    return;
                }

                // Small screens: the image and the details (title included) are centered together, under the close button
                details = infoHeight(info);
                top = Math.max(55, (screen - image - details) / 2);
                box.style.translate = '0 ' + Math.round(top - (screen - image) / 2) + 'px';
                info.style.maxHeight = Math.max(80, screen - top - image - 10) + 'px';
            }

            // Copy the film details of the opened image into the lightbox (cloned nodes: no HTML parsing)
            function showFilm() {
                var link = this && this[0];
                var item = link && link.closest ? link.closest('.g-imagegrid-item') : null;
                var film = item ? item.querySelector('.g-imagegrid-film') : null;
                var info = infoBox();
                var title = document.getElementById('lightcase-title');
                var caption = document.getElementById('lightcase-caption');
                var copy;

                removeFilm();
                if (!film || !info) { return; }

                // Lightcase repeats the alternative text as the caption: show it once next to the details
                if (title && caption && caption.textContent === title.textContent) { caption.style.display = 'none'; }

                copy = film.cloneNode(true);
                copy.hidden = false;
                info.appendChild(copy);
                root.classList.add(openClass);
                fit();
            }

            var options = {
                maxWidth: '100%',
                maxHeight: '100%',
                video: {width: '1280', height: '720'},
                onStart: {gImagegrid: removeFilm},
                onBeforeCalculateDimensions: {gImagegrid: showFilm},
                onAfterCalculateDimensions: {gImagegrid: place},
                onResize: {gImagegrid: place},
                onClose: {gImagegrid: removeFilm}
            };

            // Same options as Gantry, plus the film details hooks for the image grid links
            function bind() {
                var $ = window.jQuery;

                if (!$ || !$.fn.lightcase) { return false; }
                $('.g-imagegrid [data-rel^=lightcase]').lightcase(options);
                return true;
            }

            // Runs before the Lightcase resize handler (capture), so the new sizes are used right away
            window.addEventListener('resize', fit, true);

            document.addEventListener('DOMContentLoaded', function () {
                setTimeout(bind, 0);
            });

            // Load Lightcase again when the Joomla cache dropped it
            window.addEventListener('load', function () {
                var $ = window.jQuery;
                var css, js;

                if (bind() || !$) { return; }
                css = document.createElement('link');
                css.rel = 'stylesheet';
                css.href = '{{ url('gantry-assets://css/lightcase.css')|e('js') }}';
                document.head.appendChild(css);
                js = document.createElement('script');
                js.src = '{{ url('gantry-assets://js/lightcase.js')|e('js') }}';
                js.onload = function () {
                    $('[data-rel^=lightcase]').lightcase({maxWidth: '100%', maxHeight: '100%', video: {width: '1280', height: '720'}});
                    bind();
                };
                document.head.appendChild(js);
            });
        })();

        (function () {
            if (window.gImagegridLightboxTitle) { return; }
            window.gImagegridLightboxTitle = true;

            // Show the title as a tooltip on the enlarged image only (Lightcase copies it into the alt)
            document.addEventListener('mouseover', function (event) {
                var img = event.target;
                var origin = window.lightcase && window.lightcase.origin && window.lightcase.origin[0];

                if (img.tagName !== 'IMG' || !img.closest || !img.closest('#lightcase-case') || img.title || !img.alt) { return; }
                if (!origin || !origin.closest || !origin.closest('.g-imagegrid')) { return; }
                img.title = img.alt;
            });
        })();
    </script>

    {% if (filter or search) and alltags %}
        <script>
            (function () {
                if (window.gImagegridFilter) { return; }
                window.gImagegridFilter = true;

                // Lowercase and strip accents so "Été" matches "ete" (escaped range: Gantry re-encodes non-ASCII text in footer scripts)
                function normalize(str) {
                    str = (str || '').toLowerCase().trim();
                    return str.normalize ? str.normalize('NFD').replace(/[\u0300-\u036f]/g, '') : str;
                }

                function setup(grid) {
                    var buttons = grid.querySelectorAll('.g-imagegrid-filter');
                    var search = grid.querySelector('.g-imagegrid-search');
                    var items = grid.querySelectorAll('.g-imagegrid-item');
                    var empty = grid.querySelector('.g-imagegrid-empty');
                    var current = '*';

                    Array.prototype.forEach.call(items, function (item) {
                        var link = item.querySelector('.g-imagegrid-link');
                        if (link) { link.setAttribute('data-imagegrid-rel', link.getAttribute('data-rel')); }
                    });

                    function apply() {
                        var query = search ? normalize(search.value) : '';
                        var visible = 0;

                        Array.prototype.forEach.call(items, function (item) {
                            var tags = (item.getAttribute('data-tags') || '').split('|').filter(Boolean);
                            var show = (current === '*' || tags.indexOf(current) !== -1) &&
                                (!query || tags.some(function (tag) { return normalize(tag).indexOf(query) !== -1; }));
                            var link = item.querySelector('.g-imagegrid-link');

                            item.classList.toggle('g-imagegrid-hidden', !show);
                            // Keep hidden images out of the lightcase album navigation
                            if (link) { link.setAttribute('data-rel', show ? link.getAttribute('data-imagegrid-rel') : 'lightcase'); }
                            if (show) { visible++; }
                        });

                        if (empty) { empty.hidden = visible > 0; }
                    }

                    Array.prototype.forEach.call(buttons, function (button) {
                        button.addEventListener('click', function () {
                            current = button.getAttribute('data-filter');
                            Array.prototype.forEach.call(buttons, function (other) {
                                other.classList.toggle('active', other === button);
                                other.setAttribute('aria-pressed', other === button ? 'true' : 'false');
                            });
                            apply();
                        });
                    });

                    if (search) { search.addEventListener('input', apply); }
                }

                function init() {
                    Array.prototype.forEach.call(document.querySelectorAll('.g-imagegrid[data-imagegrid-filter]'), setup);
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', init);
                } else {
                    init();
                }
            })();
        </script>
    {% endif %}

{% endblock %}
